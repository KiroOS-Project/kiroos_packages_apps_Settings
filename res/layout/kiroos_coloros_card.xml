<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS "About phone" header: one quiet card in the same language as the update screen
     (pure black page, #121214 card, white type, iOS-like grays). Tapping it expands into
     the KiroOS update screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kiroos_upd_bg"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:id="@+id/kiroos_hero_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/kiroos_about_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:paddingEnd="20dp"
        android:paddingStart="20dp"
        android:paddingTop="22dp">

        <!-- Identity: mark, name + version, channel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/kiroos_about_mark_bg">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/kiroos_upd_mark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:text="@string/kiroos_brand_name"
                    android:textColor="@color/kiroos_upd_text"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/kiroos_software_version_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/kiroos_software_version_sub"
                    android:textColor="@color/kiroos_upd_text3"
                    android:textSize="13sp" />

                <!-- the channel under the version: beside the name it squeezed the column
                     until "KiroOS" broke in two lines -->
                <TextView
                    android:id="@+id/kiroos_top_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/kiroos_upd_badge"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:text="@string/kiroos_badge_dev_beta"
                    android:textColor="@color/kiroos_upd_text2"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/kiroos_device_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/kiroos_device_title"
            android:textColor="@color/kiroos_upd_text3"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="16dp"
            android:background="@color/kiroos_upd_divider" />

        <!-- Update status: dot + text + chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/kiroos_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/kiroos_about_dot" />

            <TextView
                android:id="@+id/kiroos_status_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kiroos_status_not_checked"
                android:textColor="@color/kiroos_upd_text2"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/kiroos_about_chevron" />
        </LinearLayout>

        <!-- Only when an update is available -->
        <TextView
            android:id="@+id/kiroos_changelog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/kiroos_changelog_title"
            android:textColor="@color/kiroos_upd_text"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/kiroos_changelog_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="3"
            android:textColor="@color/kiroos_upd_text3"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/kiroos_btn_check_updates"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/kiroos_about_button_secondary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/kiroos_btn_check_updates_text"
            android:textAllCaps="false"
            android:textColor="@color/kiroos_upd_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
