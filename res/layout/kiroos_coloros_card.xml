<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:background="#000000">

    <!-- ColorOS Style Hero Card matching User Reference -->
    <LinearLayout
        android:id="@+id/kiroos_hero_card_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/kiroos_coloros_card_bg"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp">

        <!-- Top Section: Huge Typography 1.0 and Developer Beta 1 Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kiroos_version_title"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/kiroos_top_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/kiroos_badge_bg"
                android:text="@string/kiroos_badge_dev_beta"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Section: Subtitle and Branding -->
        <TextView
            android:id="@+id/kiroos_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_status_updated"
            android:textColor="#80D8FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_brand_name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_device_title"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Info Detail Card with Developer Beta 1 Changelog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:background="#161616"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_software_version_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kiroos_software_version_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_software_version_sub"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/kiroos_changelog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_changelog_title"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/kiroos_changelog_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kiroos_changelog_summary"
            android:textColor="#B0B0B5"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Prominent Action Button: Cerca aggiornamenti (opens internal screen) -->
    <Button
        android:id="@+id/kiroos_btn_check_updates"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/kiroos_button_pill_bg"
        android:text="@string/kiroos_btn_check_updates_text"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />

</LinearLayout>
