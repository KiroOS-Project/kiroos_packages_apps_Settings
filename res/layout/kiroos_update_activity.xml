<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp"
        android:gravity="center_horizontal">

        <!-- Animated Center Emblem / Pulse Graphic -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/kiroos_update_glow_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kiroos_badge_bg" />

            <ImageView
                android:id="@+id/kiroos_update_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings_about"
                android:tint="#00E5FF" />
        </FrameLayout>

        <!-- Version Typography -->
        <TextView
            android:id="@+id/kiroos_update_version_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/kiroos_update_version_header"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kiroos_update_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/kiroos_badge_bg"
            android:text="@string/kiroos_badge_dev_beta"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Status Box -->
        <TextView
            android:id="@+id/kiroos_update_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/kiroos_updater_package_found"
            android:textColor="#80D8FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/kiroos_update_status_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/kiroos_updater_package_desc"
            android:textColor="#B0B0B5"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        <!-- Progress Bar Container -->
        <LinearLayout
            android:id="@+id/kiroos_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/kiroos_update_progressbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="#00E5FF"
                android:progressBackgroundTint="#222222" />

            <TextView
                android:id="@+id/kiroos_update_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="#80D8FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="@string/kiroos_updater_initial_progress" />
        </LinearLayout>

        <!-- Action Button -->
        <Button
            android:id="@+id/kiroos_btn_check_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/kiroos_button_pill_bg"
            android:text="@string/kiroos_updater_btn_download_install"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <!-- Release notes of the available update (filled from update.json) -->
        <LinearLayout
            android:id="@+id/kiroos_release_notes_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:background="#181818"
            android:padding="20dp">

            <TextView
                android:id="@+id/kiroos_release_notes_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kiroos_updater_release_notes_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kiroos_release_notes_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/kiroos_updater_release_notes_content"
                android:textColor="#B0B0B5"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- Hardware & System Spec Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="#181818"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kiroos_updater_spec_title"
                android:textColor="#80D8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- One row per spec (label | value), filled by KiroOSUpdateActivity -->
            <LinearLayout
                android:id="@+id/kiroos_spec_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
