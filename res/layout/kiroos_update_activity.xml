<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS system update: ColorOS-like layout (hero with progress ring, section cards,
     fixed pill button at the bottom), pure black for the AMOLED panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ScrollView
        android:id="@+id/kiroos_update_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="112dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="28dp">

                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="132dp">

                    <com.android.settings.deviceinfo.KiroOSRingView
                        android:id="@+id/kiroos_update_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/kiroos_update_logo"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/kiroos_upd_mark" />

                    <TextView
                        android:id="@+id/kiroos_update_ring_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-light"
                        android:textColor="#FFFFFFFF"
                        android:textSize="30sp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/kiroos_update_version_header_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:text="@string/kiroos_update_version_header"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/kiroos_update_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/kiroos_upd_badge"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="@string/kiroos_badge_dev_beta"
                    android:textColor="#FFC7C7CC"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/kiroos_update_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/kiroos_ota_checking"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/kiroos_update_status_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FF8E8E93"
                    android:textSize="13sp" />

                <!-- Download / verification details under the status -->
                <LinearLayout
                    android:id="@+id/kiroos_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/kiroos_update_progressbar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:max="1000"
                        android:progressBackgroundTint="#FF1C1C1E"
                        android:progressTint="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/kiroos_update_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="#FF8E8E93"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- What's new -->
            <LinearLayout
                android:id="@+id/kiroos_release_notes_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/kiroos_upd_card"
                android:orientation="vertical"
                android:paddingBottom="20dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/kiroos_release_notes_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/kiroos_release_notes_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="#FFC7C7CC"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Device information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kiroos_upd_card"
                android:orientation="vertical"
                android:paddingBottom="18dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/kiroos_updater_spec_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <!-- One row per spec (label | value), filled by KiroOSUpdateActivity -->
                <LinearLayout
                    android:id="@+id/kiroos_spec_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Device statistics sent with the update check (on/off) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/kiroos_upd_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp"
                android:paddingEnd="16dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/kiroos_stats_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/kiroos_stats_desc"
                        android:textColor="#FF8E8E93"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/kiroos_stats_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom action -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/kiroos_upd_bottom_fade"
        android:paddingBottom="24dp"
        android:paddingEnd="24dp"
        android:paddingStart="24dp"
        android:paddingTop="28dp">

        <Button
            android:id="@+id/kiroos_btn_check_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/kiroos_upd_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/kiroos_ota_check"
            android:textAllCaps="false"
            android:textColor="@color/kiroos_upd_button_text"
            android:textSize="16sp" />
    </FrameLayout>
</FrameLayout>
