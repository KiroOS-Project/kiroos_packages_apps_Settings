<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS 2.1 grouped card, bottom row -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/kiro_group_card" />
                    <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="1px" android:left="68dp">
                <shape><solid android:color="@color/kiro_group_divider" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
        </shape>
    </item>
</ripple>
